# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, used by scripts/import-leads.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public site URL, used for sign-in links
NEXT_PUBLIC_SITE_URL=https://trustani.com
# Set to 1 once an SMS/WhatsApp provider is configured in Supabase Auth
NEXT_PUBLIC_PHONE_AUTH=0
